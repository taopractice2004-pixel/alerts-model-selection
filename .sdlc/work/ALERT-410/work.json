  "summary": "Add multi-tag support for alerts with tag assignment endpoints and tag-based alert filtering.",
  "acceptance_criteria": [
    {
      "id": "AC1",
      "text": "Introduce a Tag concept with a many-to-many relationship to Alert, including database schema changes and migration for the join table."
    },
    {
      "id": "AC2",
      "text": "POST /api/alerts/{id}/tags adds one or more tags to an alert, dedupes case-insensitively, enforces max 10 tags per alert, and enforces each tag length between 1 and 30 characters."
    },
    {
      "id": "AC3",
      "text": "DELETE /api/alerts/{id}/tags/{tag} removes a tag assignment and returns 404 when the alert does not exist or the tag is not assigned to that alert."
    },
    {
      "id": "AC4",
      "text": "GET /api/alerts supports an optional tag query filter that composes with existing filters: isActive, severity, created date range, and search."
    },
    {
      "id": "AC5",
      "text": "AlertResponse includes assigned tags."
    }
  ],
