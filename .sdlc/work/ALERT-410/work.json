  "summary": "Add multi-tag assignment, removal, filtering, and response projection for alerts.",
  "acceptance_criteria": [
    {
      "id": "AC1",
      "text": "Persist a new Tag concept for alerts with a many-to-many relationship and a database migration that creates the required tag and join-table schema."
    },
    {
      "id": "AC2",
      "text": "POST /api/alerts/{id}/tags adds one or more tags to an existing alert, deduplicates requested and existing assignments case-insensitively, rejects tags longer than 30 characters or blank tags, and enforces a maximum of 10 tags per alert."
    },
    {
      "id": "AC3",
      "text": "DELETE /api/alerts/{id}/tags/{tag} removes the tag assignment from an alert and returns 404 when either the alert does not exist or the specified tag is not assigned to it."
    },
    {
      "id": "AC4",
      "text": "GET /api/alerts supports an optional tag filter that composes with the existing isActive, severity, createdFrom, createdTo, and search filters."
    },
    {
      "id": "AC5",
      "text": "AlertResponse includes the alert's tags for single-item and paged alert responses."
    }
  ],
