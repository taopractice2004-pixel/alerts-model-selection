  "summary": "Add alert tagging with many-to-many tags, tag management endpoints, list filtering by tag, and tag projection in alert responses.",
  "acceptance_criteria": [
    {
      "id": "AC1",
      "text": "Introduce a new Tag concept with a many-to-many relationship to Alert, including EF model/config updates and a migration that creates the required join table."
    },
    {
      "id": "AC2",
      "text": "POST /api/alerts/{id}/tags adds one or more tags for an alert with case-insensitive deduplication, enforcing maximum 10 tags per alert and per-tag length of 1 to 30 characters."
    },
    {
      "id": "AC3",
      "text": "DELETE /api/alerts/{id}/tags/{tag} removes a tag assignment and returns 404 when the alert does not exist or the tag assignment does not exist."
    },
    {
      "id": "AC4",
      "text": "GET /api/alerts supports an optional tag query filter that composes with existing filters (isActive, severity, created date range, search)."
    },
    {
      "id": "AC5",
      "text": "AlertResponse includes the alert tags in API responses where AlertResponse is returned."
    }
  ],
